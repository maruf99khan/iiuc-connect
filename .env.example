# Copy this file to .env.local and fill in the values.
# Both values are safe to expose to the browser: data is protected by
# Row Level Security in the database, not by keeping these secret.
# Find them in the Supabase dashboard under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Cron jobs (/api/cron/*). Server only: never prefix with NEXT_PUBLIC_, never
# commit real values. Leave unset in development; each job answers "Not configured".
# SUPABASE_SECRET_KEY=   # dashboard -> Project Settings -> API Keys -> secret key
# CRON_SECRET=           # any random string of 24 or more characters
# EVIDENCE_RETENTION_DAYS=30

# Email notifications (/api/cron/send-notifications, runs every 5 min on Vercel).
# Sign up at resend.com (free: 100 emails/day, 3,000/month).
# NOTIFICATIONS_FROM must be a sender you have verified in Resend.
# While testing before domain verification, use onboarding@resend.dev and send
# only to the email address you used to register with Resend.
# RESEND_API_KEY=        # Resend dashboard -> API Keys
# NOTIFICATIONS_FROM=    # e.g. IIUC Connect <no-reply@yourdomain.com>
